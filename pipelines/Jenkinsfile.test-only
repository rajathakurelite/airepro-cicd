/**
 * Run Playwright tests from airepro_cicd for one area against stage (default) or production.
 */
@Library('airepro-pipeline') _

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 120, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  parameters {
    choice(
      name: 'TEST_AREA',
      choices: ['hire', 'security', 'ems', 'obo', 'email', 'blogging', 'lernify', 'timesheet', 'feature_flag', 'other'],
      description: 'Test area folder in airepro_cicd'
    )
    choice(
      name: 'ENV',
      choices: ['stage', 'production'],
      description: 'stage uses API_BASE_URL; production defaults to vps if API_BASE_URL is unused'
    )
    string(
      name: 'GIT_BRANCH',
      defaultValue: 'fixes_ai',
      description: 'airepro_cicd branch'
    )
    choice(
      name: 'API_BASE_URL',
      choices: [
        'https://prodhirebe.airepro.in/api/v1',
        'https://server.airepro.in/api/v1',
      ],
      description: 'Hire API host. Default: https://prodhirebe.airepro.in/api/v1'
    )
    string(
      name: 'REPEAT_COUNT',
      defaultValue: '1',
      description: 'Repeat 1–10'
    )
  }

  stages {
    stage('Test') {
      steps {
        script {
          def repeat = Math.min(Math.max((params.REPEAT_COUNT ?: '1').toInteger(), 1), 10)
          aireproTest([
            env: params.ENV,
            areas: [params.TEST_AREA],
            api_base_url: params.API_BASE_URL?.trim() ?: '',
            test_repo: [
              git_url: 'https://github.com/eliteprofessional/airepro_cicd.git',
              branch: params.GIT_BRANCH,
              credentials_id: 'github-rajathakur',
            ],
          ])
        }
      }
    }
  }
}
